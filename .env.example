# Puerto del servidor web
PORT=3000

# Servidor SQL Server (instancia por defecto: localhost; con nombre: localhost\SQLEXPRESS)
DB_SERVER=localhost
DB_NAME=IO2_Sistema

# Tipo de autenticación: "windows" (por defecto) o "sql"
DB_AUTH=windows

# Solo si DB_AUTH=sql
DB_USER=sa
DB_PASS=tu_password

# Solo si DB_AUTH=windows: nombre del driver ODBC instalado
DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server

# Solo si DB_AUTH=sql (por ejemplo, Azure SQL en la nube)
DB_PORT=1433
DB_ENCRYPT=true
DB_TRUST_CERT=true
